# 地图加载模式（构建时注入）：
# auto    - 找到 public/offline-map/manifest.json 时优先使用本地 PMTiles，
#           否则回退到 Mapbox 在线地图
# offline - 强制使用本地离线地图，不需要 Mapbox Token
# online  - 强制使用 Mapbox 在线地图，需要网络和下面的 Public Token
VITE_MAP_MODE=auto

# 仅 online 模式，或 auto 模式未找到离线地图包时需要。
# 请勿把真实 Token 提交到版本库。
VITE_MAPBOX_ACCESS_TOKEN=
